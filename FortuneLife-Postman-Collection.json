          }
        },
        { "name": "4.6 Activate Agent", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/agent/activate/1", "host": ["{{devUrl}}"], "path": ["agent", "activate", "1"] } } },
        { "name": "4.7 Delete Agent", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/agent/1", "host": ["{{devUrl}}"], "path": ["agent", "1"] } } }
      ]
