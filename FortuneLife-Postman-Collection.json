            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{devUrl}}/employee", "host": ["{{devUrl}}"], "path": ["employee"] },
            "body": { "mode": "raw", "raw": "{\n  \"id\": 1,\n  \"salary\": 55000,\n  \"userDto\": {\n    \"id\": 2,\n    \"firstName\": \"Jane\",\n    \"lastName\": \"EmployeeUpdated\",\n    \"username\": \"jane@emp1\",\n    \"email\": \"janeemp@example.com\",\n    \"mobileNumber\": \"9876543211\",\n    \"gender\": \"FEMALE\",\n    \"dateOfBirth\": \"1992-08-20\"\n  }\n}" }
          }
        },
        { "name": "3.6 Activate Employee", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/employee/activate/1", "host": ["{{devUrl}}"], "path": ["employee", "activate", "1"] } } },
        { "name": "3.7 Delete Employee", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/employee/1", "host": ["{{devUrl}}"], "path": ["employee", "1"] } } }
      ]
    },

