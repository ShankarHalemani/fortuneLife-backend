            "url": { "raw": "{{devUrl}}/employee?role=EMPLOYEE", "host": ["{{devUrl}}"], "path": ["employee"], "query": [{ "key": "role", "value": "EMPLOYEE" }] },
            "body": { "mode": "raw", "raw": "{\n  \"salary\": 50000,\n  \"userDto\": {\n    \"firstName\": \"Jane\",\n    \"lastName\": \"Employee\",\n    \"username\": \"jane@emp1\",\n    \"password\": \"Employee@1234\",\n    \"email\": \"janeemp@example.com\",\n    \"mobileNumber\": \"9876543211\",\n    \"gender\": \"FEMALE\",\n    \"dateOfBirth\": \"1992-08-20\"\n  }\n}" }
          }
        },
        { "name": "3.2 Get All Employees", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/employee", "host": ["{{devUrl}}"], "path": ["employee"] } } },
        { "name": "3.3 Get Employee by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/employee/1", "host": ["{{devUrl}}"], "path": ["employee", "1"] } } },
        { "name": "3.4 Get Logged Employee", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }], "url": { "raw": "{{devUrl}}/employee/logged", "host": ["{{devUrl}}"], "path": ["employee", "logged"] } } },
        {
          "name": "3.5 Update Employee",
          "request": {
