    {
      "name": "5. Agent Withdrawals",
      "item": [
        {
          "name": "5.1 Claim Withdrawal",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": { "raw": "{{devUrl}}/agent/withdrawal/1?amount=5000", "host": ["{{devUrl}}"], "path": ["agent", "withdrawal", "1"], "query": [{ "key": "amount", "value": "5000" }] },
            "body": { "mode": "raw", "raw": "{\n  \"id\": 1,\n  \"accountNumber\": \"1234567890\",\n  \"bankName\": \"State Bank\",\n  \"ifscCode\": \"SBIN0001234\",\n  \"userDto\": { \"id\": 3, \"firstName\": \"Mike\", \"lastName\": \"Agent\" }\n}" }
          }
        },
        { "name": "5.2 Approve Withdrawal", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/agent/withdrawal/approve/1?remarks=Approved", "host": ["{{devUrl}}"], "path": ["agent", "withdrawal", "approve", "1"], "query": [{ "key": "remarks", "value": "Approved" }] } } },
        { "name": "5.3 Reject Withdrawal", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/agent/withdrawal/reject/1?remarks=Insufficient+balance", "host": ["{{devUrl}}"], "path": ["agent", "withdrawal", "reject", "1"], "query": [{ "key": "remarks", "value": "Insufficient balance" }] } } },
        { "name": "5.4 Get All Withdrawal Requests", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/agent/withdrawal-requests", "host": ["{{devUrl}}"], "path": ["agent", "withdrawal-requests"] } } },
        { "name": "5.5 Get My Withdrawals (Agent)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }], "url": { "raw": "{{devUrl}}/agent/allwithdrawal", "host": ["{{devUrl}}"], "path": ["agent", "allwithdrawal"] } } },
        { "name": "5.6 Agent All Commissions", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }], "url": { "raw": "{{devUrl}}/policy/all-commission", "host": ["{{devUrl}}"], "path": ["policy", "all-commission"] } } },
        { "name": "5.7 Agent All Clients", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }], "url": { "raw": "{{devUrl}}/policy/all-clients", "host": ["{{devUrl}}"], "path": ["policy", "all-clients"] } } }
      ]
    },

