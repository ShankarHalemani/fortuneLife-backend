{
  "info": {
    "name": "FortuneLife API Collection",
    "description": "Complete API collection for FortuneLife Insurance Application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082/fortuneLife" },
    { "key": "devUrl", "value": "https://fortunelife-backend.onrender.com/fortuneLife" },
    { "key": "adminToken", "value": "" },
    { "key": "employeeToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "agentToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        { "name": "1.01 Register Admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{devUrl}}/auth/register?tempRole=ADMIN", "host": ["{{devUrl}}"], "path": ["auth", "register"], "query": [{ "key": "tempRole", "value": "ADMIN" }] }, "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Admin\",\n  \"username\": \"john@admin1\",\n  \"password\": \"Admin@1234\",\n  \"email\": \"johnadmin@example.com\",\n  \"mobileNumber\": \"9876543210\",\n  \"gender\": \"MALE\",\n  \"dateOfBirth\": \"1990-05-15\"\n}" } } },
        { "name": "1.02 Login as Admin", "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();\npm.collectionVariables.set('adminToken', json.accessToken);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{devUrl}}/auth/login", "host": ["{{devUrl}}"], "path": ["auth", "login"] }, "body": { "mode": "raw", "raw": "{\n  \"usernameOrEmail\": \"john@admin1\",\n  \"password\": \"Admin@1234\",\n  \"role\": \"ADMIN\"\n}" } } },
        { "name": "1.03 Register Agent", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{devUrl}}/auth/register?tempRole=AGENT", "host": ["{{devUrl}}"], "path": ["auth", "register"], "query": [{ "key": "tempRole", "value": "AGENT" }] }, "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Mike\",\n  \"lastName\": \"Agent\",\n  \"username\": \"mike@agent1\",\n  \"password\": \"Agent@12345\",\n  \"email\": \"mikeagent@example.com\",\n  \"mobileNumber\": \"9876543212\",\n  \"gender\": \"MALE\",\n  \"dateOfBirth\": \"1988-03-10\"\n}" } } },
        { "name": "1.04 Register Customer", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{devUrl}}/auth/register?tempRole=CUSTOMER", "host": ["{{devUrl}}"], "path": ["auth", "register"], "query": [{ "key": "tempRole", "value": "CUSTOMER" }] }, "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Customer\",\n  \"username\": \"alice@cust1\",\n  \"password\": \"Customer@1234\",\n  \"email\": \"alicecust@example.com\",\n  \"mobileNumber\": \"9876543213\",\n  \"gender\": \"FEMALE\",\n  \"dateOfBirth\": \"1995-11-25\"\n}" } } },
        { "name": "1.05 Login as Agent", "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();\npm.collectionVariables.set('agentToken', json.accessToken);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{devUrl}}/auth/login", "host": ["{{devUrl}}"], "path": ["auth", "login"] }, "body": { "mode": "raw", "raw": "{\n  \"usernameOrEmail\": \"mike@agent1\",\n  \"password\": \"Agent@12345\",\n  \"role\": \"AGENT\"\n}" } } },
        { "name": "1.06 Login as Customer", "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();\npm.collectionVariables.set('customerToken', json.accessToken);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{devUrl}}/auth/login", "host": ["{{devUrl}}"], "path": ["auth", "login"] }, "body": { "mode": "raw", "raw": "{\n  \"usernameOrEmail\": \"alice@cust1\",\n  \"password\": \"Customer@1234\",\n  \"role\": \"CUSTOMER\"\n}" } } },
        { "name": "1.07 Login as Employee", "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();\npm.collectionVariables.set('employeeToken', json.accessToken);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{devUrl}}/auth/login", "host": ["{{devUrl}}"], "path": ["auth", "login"] }, "body": { "mode": "raw", "raw": "{\n  \"usernameOrEmail\": \"jane@emp1\",\n  \"password\": \"Employee@1234\",\n  \"role\": \"EMPLOYEE\"\n}" } } },
        { "name": "1.08 Get Logged User", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/auth/loggedUser", "host": ["{{devUrl}}"], "path": ["auth", "loggedUser"] } } },
        { "name": "1.09 Validate Token", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/auth/user?role=ADMIN", "host": ["{{devUrl}}"], "path": ["auth", "user"], "query": [{ "key": "role", "value": "ADMIN" }] } } },
        {
          "name": "1.10 Send OTP",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{devUrl}}/auth/send-otp?sourceType=email&sourceValue=johnadmin@example.com",
              "host": ["{{devUrl}}"],
              "path": ["auth", "send-otp"],
              "query": [
                { "key": "sourceType", "value": "email" },
                { "key": "sourceValue", "value": "johnadmin@example.com" }
              ]
            }
          }
        },
        { "name": "1.11 Forget Password", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{devUrl}}/auth/forget-Password", "host": ["{{devUrl}}"], "path": ["auth", "forget-Password"] }, "body": { "mode": "raw", "raw": "{\n  \"userName\": \"john@admin1\",\n  \"sourceType\": \"email\",\n  \"sourceValue\": \"johnadmin@example.com\",\n  \"otpReceived\": \"123456\",\n  \"password\": \"NewAdmin@1234\"\n}" } } },
        { "name": "1.12 Change Password", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{devUrl}}/auth/change-Password", "host": ["{{devUrl}}"], "path": ["auth", "change-Password"] }, "body": { "mode": "raw", "raw": "{\n  \"id\": 1,\n  \"username\": \"john@admin1\",\n  \"password\": \"Admin@1234\"\n}" } } },
        { "name": "1.13 Logout", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/auth/logout", "host": ["{{devUrl}}"], "path": ["auth", "logout"] } } }
      ]
    },

    {
      "name": "2. Admin Management",
      "item": [
        {
          "name": "2.1 Add Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{devUrl}}/admin?role=ADMIN", "host": ["{{devUrl}}"], "path": ["admin"], "query": [{ "key": "role", "value": "ADMIN" }] },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Super\",\n  \"lastName\": \"Admin\",\n  \"username\": \"super@admin\",\n  \"password\": \"SuperAdmin@1234\",\n  \"email\": \"superadmin@example.com\",\n  \"mobileNumber\": \"9876543299\",\n  \"gender\": \"MALE\",\n  \"dateOfBirth\": \"1985-01-01\"\n}" }
          }
        },
        { "name": "2.2 Get All Admins", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/admin", "host": ["{{devUrl}}"], "path": ["admin"] } } },
        { "name": "2.3 Get Admin by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/admin/1", "host": ["{{devUrl}}"], "path": ["admin", "1"] } } },
        { "name": "2.4 Get Logged Admin", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/admin/logged", "host": ["{{devUrl}}"], "path": ["admin", "logged"] } } },
        {
          "name": "2.5 Update Admin",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{devUrl}}/admin", "host": ["{{devUrl}}"], "path": ["admin"] },
            "body": { "mode": "raw", "raw": "{\n  \"id\": 1,\n  \"firstName\": \"John\",\n  \"lastName\": \"AdminUpdated\",\n  \"username\": \"john@admin1\",\n  \"email\": \"johnadmin@example.com\",\n  \"mobileNumber\": \"9876543210\",\n  \"gender\": \"MALE\",\n  \"dateOfBirth\": \"1990-05-15\"\n}" }
          }
        },
        { "name": "2.6 Activate Admin", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/admin/activate/1", "host": ["{{devUrl}}"], "path": ["admin", "activate", "1"] } } },
        { "name": "2.7 Delete Admin", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/admin/2", "host": ["{{devUrl}}"], "path": ["admin", "2"] } } },
        { "name": "2.8 Count Report", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/admin/count", "host": ["{{devUrl}}"], "path": ["admin", "count"] } } }
      ]
    },
    {
      "name": "3. Employee Management",
      "item": [
