        { "name": "4.3 Get Agent by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": { "raw": "{{devUrl}}/agent/1", "host": ["{{devUrl}}"], "path": ["agent", "1"] } } },
        { "name": "4.4 Get Logged Agent", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{agentToken}}" }], "url": { "raw": "{{devUrl}}/agent/loggedAgent", "host": ["{{devUrl}}"], "path": ["agent", "loggedAgent"] } } },
