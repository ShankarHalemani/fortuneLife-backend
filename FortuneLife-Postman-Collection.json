  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "1.1 Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/register?tempRole=ADMIN",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"],
              "query": [{ "key": "tempRole", "value": "ADMIN" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Admin\",\n  \"username\": \"john@admin1\",\n  \"password\": \"Admin@1234\",\n  \"email\": \"johnadmin@example.com\",\n  \"mobileNumber\": \"9876543210\",\n  \"gender\": \"MALE\",\n  \"dateOfBirth\": \"1990-05-15\"\n}"
            }
          }
        },
        {
          "name": "1.2 Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["var json = pm.response.json();\npm.collectionVariables.set('adminToken', json.accessToken);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"john@admin1\",\n  \"password\": \"Admin@1234\",\n  \"role\": \"ADMIN\"\n}"
            }
          }
        },
